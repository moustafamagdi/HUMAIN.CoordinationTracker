    {
      "source": "s3d_register",
      "target": "s3d_card3",
      "type": "NoFilter"
    },
    {
      "source": "s3d_register",
      "target": "s3d_viewer",
      "type": "DataFilter"
    },
    {
      "source": "s3d_register",
      "target": "s3d_elementA",
      "type": "DataFilter"
    },
    {
      "source": "s3d_register",
      "target": "s3d_elementB",
      "type": "DataFilter"
    }
  ]
