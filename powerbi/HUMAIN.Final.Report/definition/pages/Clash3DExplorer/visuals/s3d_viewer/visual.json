{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "s3d_viewer",
  "position": {
    "x": 550,
    "y": 346,
    "z": 14000,
    "height": 413,
    "width": 1026
  },
  "visual": {
    "visualType": "specklePowerBiVisual",
    "query": {
      "queryState": {
        "modelInfo": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Metrics"
                    }
                  },
                  "Property": "3D Model Info"
                }
              },
              "queryRef": "Metrics.3D Model Info",
              "nativeQueryRef": "3D Model Info"
            }
          ]
        },
        "applicationIds": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Clash3DGeometry"
                    }
                  },
                  "Property": "Object Key"
                }
              },
              "queryRef": "Clash3DGeometry.Object Key",
              "nativeQueryRef": "Object Key"
            }
          ]
        },
        "colorBy": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Clash3DGeometry"
                    }
                  },
                  "Property": "Side"
                }
              },
              "queryRef": "Clash3DGeometry.Side",
              "nativeQueryRef": "Side"
            }
          ]
        }
      }
    },
    "objects": {
      "camera": [
        {
          "properties": {
            "zoomOnFilter": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ],
      "color": [
        {
          "properties": {
            "context": {
              "expr": {
                "Literal": {
                  "Value": "'ghosted'"
                }
              }
            }
          }
        }
      ],
      "viewMode": [
        {
          "properties": {
            "navbarHidden": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'3D VIEW | source model + element ID'"
                }
              }
            },
            "fontColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#ECF2F8'"
                    }
                  }
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            }
          }
        }
      ],
      "background": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "color": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#192536'"
                    }
                  }
                }
              }
            },
            "transparency": {
              "expr": {
                "Literal": {
                  "Value": "0D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
