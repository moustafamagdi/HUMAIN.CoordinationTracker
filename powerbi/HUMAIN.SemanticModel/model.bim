          },
          {
            "name": "Resolved All",
            "displayFolder": "Coordination workflow",
            "expression": "VAR b = [Period Start] VAR e = [Period End] RETURN COALESCE(CALCULATE(SUM(OperationalProgress[Resolved]),REMOVEFILTERS(Snapshots),Snapshots[SnapshotDateTime]>=b,Snapshots[SnapshotDateTime]<e,Snapshots[IsBaseline]=\"No\"),0)",
            "formatString": "#,0",
            "lineageTag": "8842d4f4-dbd8-41e3-8e34-893973a3cd05"
          },
          {
            "name": "Closure Rate",
            "displayFolder": "Coordination workflow",
            "expression": "DIVIDE([Actionable Resolved]+[Actionable Approved],[Actionable Previous]+[New Actionable]+[Returned to Action])",
            "formatString": "0.00%",
            "lineageTag": "19393cf7-16e3-4dc5-b876-e862cbd12d71"
          },
          {
            "name": "Approved Trend",
            "displayFolder": "Coordination workflow",
            "expression": "VAR s = MAX(Snapshots[SnapshotDateTime]) RETURN IF(s>=[Period Start] && s<[Period End],SUM(OperationalProgress[ApprovedFromActionable]))",
            "formatString": "#,0",
            "lineageTag": "270159fe-45f7-48a5-950f-dd9a0c3f52c7"
          },
          {
            "name": "Forecast Data Days",
            "displayFolder": "Coordination workflow",
            "expression": "VAR s = [Selected Snapshot] RETURN CALCULATE(DISTINCTCOUNT(Snapshots[SnapshotDate]), REMOVEFILTERS(Snapshots), Snapshots[SnapshotDateTime] > s-7, Snapshots[SnapshotDateTime] <= s)",
            "formatString": "#,0",
            "lineageTag": "45022e5f-eb3e-4003-a2ea-b52ee4a15533"
          },
          {
            "name": "Current Total Count",
            "displayFolder": "Coordination workflow",
            "expression": "COALESCE(COUNTROWS(CurrentClashes),0)",
            "formatString": "#,0",
            "lineageTag": "f65ff673-efc1-4f3d-8be9-fd0fd3d0226f"
          },
          {
            "name": "Current Critical Total",
            "displayFolder": "Coordination workflow",
            "expression": "COALESCE(CALCULATE(COUNTROWS(CurrentClashes),KEEPFILTERS(CurrentClashes[Severity]=\"Critical\")),0)",
            "formatString": "#,0",
            "lineageTag": "17f72222-ac3b-435b-b065-320b3dc4567a"
          },
          {
            "name": "Period Start",
            "displayFolder": "Reporting period",
            "expression": "VAR mode = SELECTEDVALUE(ReportingPeriod[Mode],\"All history\") RETURN SWITCH(mode,\"Today\",TODAY(),\"Last 7 days\",TODAY()-6,\"Custom period\",MIN(PeriodDates[Date]),CALCULATE(MIN(Snapshots[SnapshotDateTime]),REMOVEFILTERS(Snapshots)))",
            "lineageTag": "12a296d0-cfc6-46b5-9a32-f6107409251e"
          },
          {
            "name": "Period End",
            "displayFolder": "Reporting period",
            "expression": "VAR mode = SELECTEDVALUE(ReportingPeriod[Mode],\"All history\") RETURN SWITCH(mode,\"Today\",TODAY()+1,\"Last 7 days\",TODAY()+1,\"Custom period\",MAX(PeriodDates[Date])+1,INT(CALCULATE(MAX(Snapshots[SnapshotDateTime]),REMOVEFILTERS(Snapshots)))+1)",
            "lineageTag": "3f3b8af0-fee9-4a98-8740-bc8e1348e337"
          },
          {
            "name": "Period Snapshots",
            "displayFolder": "Reporting period",
            "expression": "VAR b = [Period Start] VAR e = [Period End] RETURN COALESCE(CALCULATE(COUNTROWS(Snapshots),REMOVEFILTERS(Snapshots),Snapshots[SnapshotDateTime]>=b,Snapshots[SnapshotDateTime]<e),0)",
            "lineageTag": "1f72f46b-5b3c-4a0f-b7c2-e694c21d6e80"
          },
          {
            "name": "Period Caption",
            "displayFolder": "Reporting period",
            "expression": "SELECTEDVALUE(ReportingPeriod[Mode],\"All history\") & \" | \" & FORMAT([Period Start],\"dd MMM yyyy\") & \" - \" & FORMAT([Period End]-1,\"dd MMM yyyy\") & \" | Movements in period; stock at end\"",
            "lineageTag": "9752989e-c1a4-4e0b-9dd4-df38e4bb1ff0"
          },
          {
            "name": "Quality Flags",
            "displayFolder": "Reporting period",
            "expression": "VAR b = [Period Start] VAR e = [Period End] RETURN COALESCE(CALCULATE(SUM(SnapshotQuality[HasAlert]),REMOVEFILTERS(Snapshots),Snapshots[SnapshotDateTime]>=b,Snapshots[SnapshotDateTime]<e),0)",
            "formatString": "#,0",
            "lineageTag": "1d983076-29a1-4edb-9f55-88b1a694e774"
          },
          {
            "name": "Missing Tests",
            "displayFolder": "Reporting period",
            "expression": "VAR b = [Period Start] VAR e = [Period End] RETURN COALESCE(CALCULATE(SUM(SnapshotQuality[TestMissing]),REMOVEFILTERS(Snapshots),Snapshots[SnapshotDateTime]>=b,Snapshots[SnapshotDateTime]<e),0)",
            "formatString": "#,0",
            "lineageTag": "866e4a87-1071-4107-9474-909d2815a010"
          },
          {
            "name": "Added Tests",
            "displayFolder": "Reporting period",
            "expression": "VAR b = [Period Start] VAR e = [Period End] RETURN COALESCE(CALCULATE(SUM(SnapshotQuality[TestAdded]),REMOVEFILTERS(Snapshots),Snapshots[SnapshotDateTime]>=b,Snapshots[SnapshotDateTime]<e),0)",
            "formatString": "#,0",
            "lineageTag": "ccfceca8-08f2-4be4-a8e4-b86fdbf81c4a"
          },
          {
            "name": "Large Drops",
            "displayFolder": "Reporting period",
            "expression": "VAR b = [Period Start] VAR e = [Period End] RETURN COALESCE(CALCULATE(SUM(SnapshotQuality[LargeDrop]),REMOVEFILTERS(Snapshots),Snapshots[SnapshotDateTime]>=b,Snapshots[SnapshotDateTime]<e),0)",
            "formatString": "#,0",
            "lineageTag": "a8a3f1b1-c5a6-4ce3-8ff0-dc2d734680b4"
          },
          {
            "name": "Unknown Status Rows",
            "displayFolder": "Reporting period",
            "expression": "VAR b = [Period Start] VAR e = [Period End] RETURN COALESCE(CALCULATE(SUM(SnapshotQuality[UnknownStatuses]),REMOVEFILTERS(Snapshots),Snapshots[SnapshotDateTime]>=b,Snapshots[SnapshotDateTime]<e),0)",
            "formatString": "#,0",
            "lineageTag": "d46473a9-c824-4d36-9409-f1b576b55a4a"
          },
          {
            "name": "Quality Banner",
            "displayFolder": "Reporting period",
            "expression": "VAR flags = CALCULATE([Quality Flags],REMOVEFILTERS(Tests)) VAR pending = CALCULATE([Quality Action Required],REMOVEFILTERS(Tests)) RETURN IF([Period Snapshots]=0,\"NO EXPORT IN PERIOD | Movement = 0; stock is last known. Check snapshot date.\",IF(pending>0,\"REVIEW DATA | \" & FORMAT(pending,\"0\") & \" alerts require action. Review in Tracker.\",IF(flags>0,\"REVIEWED | \" & FORMAT(flags,\"0\") & \" original alerts retained; none require action in period.\",\"QUALITY CHECK | No rule triggered; export completeness is not guaranteed.\")))",
            "lineageTag": "1c688b80-3234-4001-8ae2-66ff5cecdfbd"
          },
          {
            "name": "Quality Row Visible",
            "displayFolder": "Reporting period",
            "expression": "VAR s = SELECTEDVALUE(SnapshotQuality[SnapshotDateTime]) RETURN IF(s>=[Period Start] && s<[Period End] && SELECTEDVALUE(SnapshotQuality[HasAlert])=1,1)",
            "lineageTag": "04441ada-6da8-47d8-b9d2-b9b93fdffa2e"
          },
          {
            "name": "Recent Quality Flags",
            "displayFolder": "Reporting period",
            "expression": "VAR s = [Selected Snapshot] RETURN CALCULATE(SUM(SnapshotQuality[RequiresAction]),REMOVEFILTERS(Snapshots),REMOVEFILTERS(Tests),Snapshots[SnapshotDateTime]>s-7,Snapshots[SnapshotDateTime]<=s)",
            "lineageTag": "e5070ac6-5116-4900-9bb9-a3d0ec9124e4"
          },
          {
            "name": "Net Reduction Color Light",
            "displayFolder": "Presentation colors",
            "expression": "IF([Net Reduction] < 0, \"#C33D55\", \"#087F75\")",
            "lineageTag": "1e50ddc2-dec5-40dc-922c-64feecf5dff5"
          },
          {
            "name": "Quality Action Required",
            "expression": "VAR b = [Period Start] VAR e = [Period End] RETURN COALESCE(CALCULATE(SUM(SnapshotQuality[RequiresAction]),REMOVEFILTERS(Snapshots),Snapshots[SnapshotDateTime]>=b,Snapshots[SnapshotDateTime]<e),0)",
            "lineageTag": "ce44e43e-fc26-481b-94b4-804904aaed54"
          },
          {
            "name": "Accepted Quality Reviews",
            "expression": "VAR b = [Period Start] VAR e = [Period End] RETURN COALESCE(CALCULATE(COUNTROWS(SnapshotQuality),REMOVEFILTERS(Snapshots),Snapshots[SnapshotDateTime]>=b,Snapshots[SnapshotDateTime]<e,SnapshotQuality[HasAlert]=1,SnapshotQuality[ReviewStatus]=\"Accepted\"),0)",
            "lineageTag": "aa222c46-af52-4324-9ed2-c01bce752413"
          },
          {
            "name": "Quality Needs Correction",
            "expression": "VAR b = [Period Start] VAR e = [Period End] RETURN COALESCE(CALCULATE(COUNTROWS(SnapshotQuality),REMOVEFILTERS(Snapshots),Snapshots[SnapshotDateTime]>=b,Snapshots[SnapshotDateTime]<e,SnapshotQuality[HasAlert]=1,SnapshotQuality[ReviewStatus]=\"Needs Correction\"),0)",
            "lineageTag": "9218883d-0d7c-41dc-b58e-a8dadcbf700b"
          },
          {
            "name": "3D Current Clashes",
            "displayFolder": "3D Explorer",
            "expression": "COUNTROWS(CurrentClashes)",
            "formatString": "#,0",
            "lineageTag": "0298767d-8a61-43ae-bf40-17e87ba83c8b"
          },
          {
            "name": "3D Both Candidates",
            "displayFolder": "3D Explorer",
            "expression": "SUMX(VALUES(CurrentClashes[3D Clash Key]), IF(CALCULATE(COUNTROWS(Clash3DSides), Clash3DSides[CandidateCount] = 1) = 2, 1, 0))",
            "formatString": "#,0",
            "lineageTag": "cd032a5c-e475-4e98-86b4-a885d8031bac"
          },
          {
            "name": "3D Needs Review",
            "displayFolder": "3D Explorer",
            "expression": "[3D Current Clashes] - [3D Both Candidates]",
            "formatString": "#,0",
            "lineageTag": "a9230556-274a-4654-b025-16107acb8daf"
          },
          {
            "name": "3D Candidate Coverage",
            "displayFolder": "3D Explorer",
            "expression": "DIVIDE([3D Both Candidates], [3D Current Clashes])",
            "formatString": "0.0%",
            "lineageTag": "a63cea37-a8cd-4e88-8c3f-e6221d0e4ba3"
          },
          {
            "name": "3D Selection Ready",
            "displayFolder": "3D Explorer",
            "expression": "IF(HASONEVALUE(CurrentClashes[3D Clash Key]), 1, 0)",
            "formatString": "0",
            "lineageTag": "76cfe5c6-4d35-480c-b1e4-b80bf19ff028"
          },
          {
            "name": "3D Model Info",
            "displayFolder": "3D Explorer",
            "expression": "IF([3D Selection Ready] = 1, MAX(Clash3DGeometry[Model Info]))",
            "lineageTag": "fe5185b9-5df6-4271-809e-75b23a53cdf0"
          },
          {
            "name": "3D Match Summary",
            "displayFolder": "3D Explorer",
            "expression": "IF(ISEMPTY(CurrentClashes), BLANK(), VAR N = CALCULATE(COUNTROWS(Clash3DSides), Clash3DSides[CandidateCount] = 1) RETURN IF([3D Selection Ready] <> 1, \"Select one clash\", SWITCH(N, 2, \"Both elements matched by model + ID\", 1, \"One element matched only\", \"No matched elements\")))",
            "lineageTag": "2e697d8a-aa8f-45dc-9ab5-7d12a0798684"
          },
          {
            "name": "3D Selection Caption",
            "displayFolder": "3D Explorer",
            "expression": "IF([3D Selection Ready] = 1, [3D Match Summary] & \" | \" & SELECTEDVALUE(CurrentClashes[ClashGuid]), \"Select one clash in the register to load its matched elements in 3D.\")",
            "lineageTag": "f898a0a4-9685-4346-a444-94997259fcb8"
          },
          {
            "name": "3D A Match",
            "displayFolder": "3D Explorer",
            "expression": "IF([3D Selection Ready] = 1, CALCULATE(SELECTEDVALUE(Clash3DSides[MatchStatus]), Clash3DSides[Side] = \"A\"), \"Select one clash\")",
            "lineageTag": "bcb006ea-9f5c-4268-bc41-661c89cf3707"
          },
          {
            "name": "3D A Source",
            "displayFolder": "3D Explorer",
            "expression": "IF([3D Selection Ready] = 1, COALESCE(CALCULATE(SELECTEDVALUE(Clash3DGeometry[SourceFile]), Clash3DGeometry[Side] = \"A\"), \"No matched element\"), \"Select one clash\")",
            "lineageTag": "b1d627d7-33d4-4a4c-b08b-d607994394f6"
          },
          {
            "name": "3D B Match",
            "displayFolder": "3D Explorer",
            "expression": "IF([3D Selection Ready] = 1, CALCULATE(SELECTEDVALUE(Clash3DSides[MatchStatus]), Clash3DSides[Side] = \"B\"), \"Select one clash\")",
            "lineageTag": "6d3d5bd2-0bff-4433-b17a-7fb6d52107fa"
          },
          {
            "name": "3D B Source",
            "displayFolder": "3D Explorer",
            "expression": "IF([3D Selection Ready] = 1, COALESCE(CALCULATE(SELECTEDVALUE(Clash3DGeometry[SourceFile]), Clash3DGeometry[Side] = \"B\"), \"No matched element\"), \"Select one clash\")",
            "lineageTag": "87a9d11f-51fe-4b96-970f-52862904a368"
          }
