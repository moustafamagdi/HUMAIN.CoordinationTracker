          {
            "name": "properties.Source File",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "lineageTag": "90c239d2-5486-4fe1-a857-bd602388313c",
            "sourceColumn": "properties.Source File",
            "summarizeBy": "none"
          },
          {
            "name": "Model Key",
            "dataType": "string",
            "expression": [
              "VAR RawName = LOWER(TRIM(SpeckleElements[properties.Source File] & \"\"))",
              "VAR Segments = SUBSTITUTE(SUBSTITUTE(RawName, \"\\\", \"|\"), \"/\", \"|\")",
              "VAR FileName = IF(Segments = \"\", \"\", PATHITEM(Segments, PATHLENGTH(Segments), TEXT))",
              "VAR Stem = IF(RIGHT(FileName,4) IN {\".rvt\", \".nwc\", \".nwd\", \".ifc\", \".dwg\"}, LEFT(FileName, MAX(0,LEN(FileName)-4)), FileName)",
              "RETURN IF(RIGHT(Stem,9) = \"_detached\", LEFT(Stem,MAX(0,LEN(Stem)-9)), Stem)"
            ],
            "isHidden": true,
            "lineageTag": "fd53da23-62ce-471d-b128-47adf33f57df",
            "type": "calculated"
          }
        ],
        "lineageTag": "8b2d4426-ad54-4606-8985-605411bb60bc",
        "partitions": [
          {
            "name": "SpeckleElements",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                " Source = Speckle.GetTables(SpeckleModelUrl, [TableLayout = \"Simplified\"]),",
                " Properties = Source{[Key=\"expand-properties\"]}[Data],",
                " Selected = Properties({\"name\", \"properties.Element.Id\", \"properties.Source File\", \"properties.UniqueId\", \"properties.Element.Category\"}, true)",
                "in",
                " Selected"
              ],
              "type": "m"
            }
          }
        ]
      },
