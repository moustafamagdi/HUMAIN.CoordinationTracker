          {
            "name": "3D Clash Key",
            "dataType": "string",
            "expression": "CurrentClashes[TestName] & \"|\" & CurrentClashes[ClashGuid]",
            "isHidden": true,
            "lineageTag": "2a9101d3-a197-4ee6-9676-83f3ec3a1bb3",
            "type": "calculated"
          },
          {
            "name": "3D A Model Key",
            "dataType": "string",
            "expression": [
              "VAR PathHierarchy = SUBSTITUTE(TRIM(CurrentClashes[ItemAPath] & \"\"), \" > \", \"|\")",
              "VAR NodeCount = IF(PathHierarchy = \"\",0,PATHLENGTH(PathHierarchy))",
              "VAR FileNodes = FILTER(ADDCOLUMNS(GENERATESERIES(1,NodeCount), \"NodeName\", TRIM(PATHITEM(PathHierarchy,[Value],TEXT))), RIGHT(LOWER([NodeName]),4) IN {\".rvt\", \".nwc\", \".nwd\", \".ifc\", \".dwg\"})",
              "VAR LastFile = MAXX(TOPN(1,FileNodes,[Value],DESC),[NodeName])",
              "RETURN VAR RawName = LOWER(TRIM(LastFile & \"\"))",
              "VAR Segments = SUBSTITUTE(SUBSTITUTE(RawName, \"\\\", \"|\"), \"/\", \"|\")",
              "VAR FileName = IF(Segments = \"\", \"\", PATHITEM(Segments, PATHLENGTH(Segments), TEXT))",
              "VAR Stem = IF(RIGHT(FileName,4) IN {\".rvt\", \".nwc\", \".nwd\", \".ifc\", \".dwg\"}, LEFT(FileName, MAX(0,LEN(FileName)-4)), FileName)",
              "RETURN IF(RIGHT(Stem,9) = \"_detached\", LEFT(Stem,MAX(0,LEN(Stem)-9)), Stem)"
            ],
            "isHidden": true,
            "lineageTag": "7a56bee8-d7ad-4281-8796-229fcc99a28c",
            "type": "calculated"
          },
          {
            "name": "3D B Model Key",
            "dataType": "string",
            "expression": [
              "VAR PathHierarchy = SUBSTITUTE(TRIM(CurrentClashes[ItemBPath] & \"\"), \" > \", \"|\")",
              "VAR NodeCount = IF(PathHierarchy = \"\",0,PATHLENGTH(PathHierarchy))",
              "VAR FileNodes = FILTER(ADDCOLUMNS(GENERATESERIES(1,NodeCount), \"NodeName\", TRIM(PATHITEM(PathHierarchy,[Value],TEXT))), RIGHT(LOWER([NodeName]),4) IN {\".rvt\", \".nwc\", \".nwd\", \".ifc\", \".dwg\"})",
              "VAR LastFile = MAXX(TOPN(1,FileNodes,[Value],DESC),[NodeName])",
              "RETURN VAR RawName = LOWER(TRIM(LastFile & \"\"))",
              "VAR Segments = SUBSTITUTE(SUBSTITUTE(RawName, \"\\\", \"|\"), \"/\", \"|\")",
              "VAR FileName = IF(Segments = \"\", \"\", PATHITEM(Segments, PATHLENGTH(Segments), TEXT))",
              "VAR Stem = IF(RIGHT(FileName,4) IN {\".rvt\", \".nwc\", \".nwd\", \".ifc\", \".dwg\"}, LEFT(FileName, MAX(0,LEN(FileName)-4)), FileName)",
              "RETURN IF(RIGHT(Stem,9) = \"_detached\", LEFT(Stem,MAX(0,LEN(Stem)-9)), Stem)"
            ],
            "isHidden": true,
            "lineageTag": "1e2b76e5-e065-42ee-9e19-decd660005b9",
            "type": "calculated"
          }
        ],
        "lineageTag": "57a8848f-3e49-45e3-9400-4c5ab6d47635",
        "partitions": [
          {
            "name": "CurrentClashes",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                " Source = Csv.Document(File.Contents(SourceFolder & \"\\CurrentClashes.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                " Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                " Nulls = Table.ReplaceValue(Headers,\"\",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),",
                " Typed = Table.TransformColumnTypes(Nulls,{{\"SnapshotDateTime\", type datetime},{\"SnapshotDate\", type date},{\"TestName\", type text},{\"ClashGuid\", type text},{\"TrackerState\", type text},{\"NavisworksStatus\", type text},{\"Distance\", type number},{\"DateFound\", type datetime},{\"GridLocation\", type text},{\"X\", type number},{\"Y\", type number},{\"Z\", type number},{\"ItemAElementId\", type text},{\"ItemAName\", type text},{\"ItemALayer\", type text},{\"ItemAPath\", type text},{\"ItemBElementId\", type text},{\"ItemBName\", type text},{\"ItemBLayer\", type text},{\"ItemBPath\", type text},{\"Description\", type text},{\"Comments\", type text},{\"Severity\", type text},{\"DisciplineA\", type text},{\"DisciplineB\", type text},{\"DisciplinePair\", type text},{\"FirstSeen\", type datetime},{\"AgeDays\", Int64.Type},{\"AgeBucket\", type text},{\"ReopenCount\", Int64.Type},{\"IsStale14Plus\", type text}},\"en-US\")",
                "in",
                " Table.AddColumn(Typed, \"CoordinationState\", each let s = if [NavisworksStatus] = null then \"\" else Text.Lower(Text.Trim([NavisworksStatus])) in if s = \"resolved\" then \"Resolved\" else if s = \"approved\" then \"Approved\" else \"Actionable\", type text)"
              ],
              "type": "m"
            }
          }
        ]
      },
