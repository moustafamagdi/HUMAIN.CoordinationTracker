            "lineageTag": "efc1d321-a1f4-4a47-bc6a-50441d80fd0c"
          },
          {
            "name": "Selected Comments",
            "displayFolder": "Clash Details",
            "expression": "IF(HASONEVALUE(CurrentClashes[TestName]) && HASONEVALUE(CurrentClashes[ClashGuid]), COALESCE(SELECTEDVALUE(CurrentClashes[Comments]), \"Not provided\"), \"Select one clash\")",
            "lineageTag": "0813178e-eeee-4f19-b5ed-7fcce416c781"
          },
          {
            "name": "Actionable Open",
            "displayFolder": "Coordination workflow",
            "expression": "VAR s = [Selected Snapshot] RETURN IF(NOT ISBLANK(s),COALESCE(CALCULATE(SUM(OperationalProgress[Actionable]),REMOVEFILTERS(Snapshots),Snapshots[SnapshotDateTime]=s),0))",
            "formatString": "#,0",
            "lineageTag": "c8053235-532a-4d82-ac44-78647e1eb3ed"
          },
          {
            "name": "Total Current",
            "displayFolder": "Coordination workflow",
            "expression": "VAR s = [Selected Snapshot] RETURN IF(NOT ISBLANK(s),COALESCE(CALCULATE(SUM(OperationalProgress[TotalCurrent]),REMOVEFILTERS(Snapshots),Snapshots[SnapshotDateTime]=s),0))",
