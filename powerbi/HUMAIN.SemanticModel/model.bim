            "displayFolder": "Clash Details",
            "expression": "IF(HASONEVALUE(CurrentClashes[TestName]) && HASONEVALUE(CurrentClashes[ClashGuid]), COALESCE(SELECTEDVALUE(CurrentClashes[ItemAPath]), \"Not provided\"), \"Select one clash\")",
            "lineageTag": "7f12a26a-c04a-4a03-969b-8732e2429b02"
