      {
        "name": "Metrics",
        "columns": [
          {
            "name": "Helper",
            "dataType": "int64",
            "isHidden": true,
            "lineageTag": "3b816eb0-c3c4-4786-9587-9dd44a3af2bf",
            "sourceColumn": "Helper"
          }
        ],
        "lineageTag": "017470a1-67ac-4d03-93de-a71757f44dc8",
        "measures": [
          {
            "name": "Selected Snapshot",
            "displayFolder": "Executive Overview",
            "expression": "VAR e = [Period End] RETURN CALCULATE(MAX(Snapshots[SnapshotDateTime]),REMOVEFILTERS(Snapshots),Snapshots[SnapshotDateTime]<e)",
            "formatString": "dd MMM yyyy HH:mm",
            "lineageTag": "0192350b-2389-4507-a4a9-6fe3ee0a4bc1"
          },
          {
            "name": "Open Clashes",
            "displayFolder": "Coordination workflow",
            "expression": "[Actionable Open]",
            "formatString": "#,0",
            "lineageTag": "c7ef25fd-541c-4832-8d50-994700ccd1da"
          },
          {
            "name": "New",
            "displayFolder": "Coordination workflow",
            "expression": "[New Actionable]",
            "formatString": "#,0",
            "lineageTag": "d0e95070-4c93-4374-8288-f243a777d28e"
          },
          {
            "name": "Resolved",
            "displayFolder": "Coordination workflow",
            "expression": "[Resolved All]",
            "formatString": "#,0",
            "lineageTag": "62e88a39-2b62-4a7c-a31c-302fa19918e1"
          },
          {
            "name": "Reopened",
            "displayFolder": "Coordination workflow",
            "expression": "[Returned to Action]",
            "formatString": "#,0",
            "lineageTag": "cb5ad36c-8a5d-41d4-861f-0cfb425a4cf3"
          },
          {
            "name": "Previous Clashes",
            "displayFolder": "Coordination workflow",
            "expression": "[Actionable Previous]",
            "formatString": "#,0",
            "lineageTag": "4e46d3da-6f4c-44ce-a95f-1d7fde6f3e7e"
          },
          {
            "name": "Net Reduction",
            "displayFolder": "Coordination workflow",
            "expression": "[Net Actionable Reduction]",
            "formatString": "#,0;-#,0;0",
            "lineageTag": "235336e8-ab8b-4991-b89f-00b5e1e44ea7"
          },
          {
            "name": "Resolution Rate",
            "displayFolder": "Coordination workflow",
            "expression": "DIVIDE([Actionable Resolved],[Actionable Previous]+[New Actionable]+[Returned to Action])",
            "formatString": "0.00%",
            "lineageTag": "2ef28e9f-a84e-44ca-8d1f-d06ab4142f56"
          },
          {
            "name": "Open Trend",
            "displayFolder": "Coordination workflow",
            "expression": "VAR s = MAX(Snapshots[SnapshotDateTime]) RETURN IF(s>=[Period Start] && s<[Period End],SUM(OperationalProgress[Actionable]))",
            "formatString": "#,0",
            "lineageTag": "92f34255-558b-40ce-9fcd-f3839b3ed543"
          },
          {
            "name": "New Inflow",
            "displayFolder": "Coordination workflow",
            "expression": "VAR s = MAX(Snapshots[SnapshotDateTime]) RETURN IF(s>=[Period Start] && s<[Period End],SUM(OperationalProgress[NewActionable])+SUM(OperationalProgress[ReturnedActionable]))",
            "formatString": "#,0",
            "lineageTag": "5eada400-7bdc-4461-8c1a-aa3e06043d28"
          },
          {
            "name": "Resolved Trend",
            "displayFolder": "Coordination workflow",
            "expression": "VAR s = MAX(Snapshots[SnapshotDateTime]) RETURN IF(s>=[Period Start] && s<[Period End],SUM(OperationalProgress[ResolvedFromActionable]))",
            "formatString": "#,0",
            "lineageTag": "2e527003-fdd1-4383-b5ad-5543356554aa"
          },
          {
            "name": "Net Trend",
            "displayFolder": "Coordination workflow",
            "expression": "SUM(OperationalProgress[NetActionableReduction])",
            "formatString": "#,0",
            "lineageTag": "746e9d2b-9db3-4d71-bfe2-66fed052d059"
          },
          {
            "name": "Rolling Net Burn per Day",
            "displayFolder": "Executive Overview",
            "expression": [
              "VAR s = [Selected Snapshot]",
              "VAR elapsed = CALCULATE(SUM(Snapshots[IntervalDays]), REMOVEFILTERS(Snapshots), Snapshots[SnapshotDateTime] > s-7, Snapshots[SnapshotDateTime] <= s, Snapshots[IsBaseline] = \"No\")",
              "VAR burn = CALCULATE([Net Trend], REMOVEFILTERS(Snapshots), Snapshots[SnapshotDateTime] > s-7, Snapshots[SnapshotDateTime] <= s, Snapshots[IsBaseline] = \"No\")",
              "RETURN DIVIDE(burn,elapsed)"
            ],
            "formatString": "0.0",
            "lineageTag": "016cf3af-319d-4e9f-a422-79fe761afebb"
          },
          {
            "name": "Forecast Finish Date",
            "displayFolder": "Coordination workflow",
            "expression": "VAR rate = [Rolling Net Burn per Day] VAR s = [Selected Snapshot] RETURN IF(NOT ISBLANK(s) && [Recent Quality Flags]=0,IF([Actionable Open]=0,INT(s),IF([Forecast Data Days]>=3 && rate>0,INT(s)+ROUNDUP(DIVIDE([Actionable Open],rate),0))))",
            "formatString": "dd MMM yyyy",
            "lineageTag": "a8b52bab-ab11-4154-85ab-b23e6353f7d6"
          },
          {
            "name": "Forecast Display",
            "displayFolder": "Coordination workflow",
            "expression": "SWITCH(TRUE(),ISBLANK([Selected Snapshot]),\"No snapshot\",[Recent Quality Flags]>0,\"Review data\",[Actionable Open]=0,\"No work remaining\",[Forecast Data Days]<3,\"Need 3 days\",ISBLANK([Forecast Finish Date]),\"No net burn\",FORMAT([Forecast Finish Date],\"dd MMM yyyy\"))",
            "lineageTag": "fd6b2e4c-dfb1-4d51-92d5-05c0edbaf69f"
          },
          {
            "name": "Top Test Open",
            "displayFolder": "Executive Overview",
            "expression": "VAR topTests = TOPN(10, ALLSELECTED(Tests[TestName]), [Open Clashes], DESC, Tests[TestName], ASC) RETURN IF(CONTAINS(topTests,Tests[TestName],SELECTEDVALUE(Tests[TestName])),[Open Clashes])",
            "formatString": "#,0",
            "lineageTag": "286a4abc-53a5-44e2-866e-a31a1374ceba"
          },
          {
            "name": "Snapshot Label",
            "displayFolder": "Executive Overview",
            "expression": "IF(ISBLANK([Selected Snapshot]),\"NO SNAPSHOT BEFORE PERIOD END\",\"STOCK AS OF  \" & FORMAT([Selected Snapshot],\"dd MMM yyyy | HH:mm\"))",
            "lineageTag": "e831895a-6bbb-4c03-9d15-9d8ac89aa986"
          },
          {
            "name": "Net Reduction Color",
            "displayFolder": "Executive Overview",
            "expression": "IF([Net Reduction] < 0, \"#EF7181\", \"#42D3BC\")",
            "lineageTag": "1b49a8eb-0884-4a19-83d0-5f03b76220bb"
          },
          {
            "name": "Tests in Scope",
            "displayFolder": "Test Performance",
            "expression": "VAR s = [Selected Snapshot] RETURN CALCULATE(DISTINCTCOUNT(TestPerformance[TestName]), KEEPFILTERS(Snapshots[SnapshotDateTime] = s))",
            "formatString": "#,0",
            "lineageTag": "02406461-f0ed-4f64-8f35-735da615378a"
          },
          {
            "name": "Tests Improving",
            "displayFolder": "Test Performance",
            "expression": "COALESCE(COUNTROWS(FILTER(VALUES(Tests[TestName]), [Net Reduction] > 0)),0)",
            "formatString": "#,0",
            "lineageTag": "b7f74ee5-2144-4760-89c5-6bf0ebbc3be0"
          },
          {
            "name": "Tests Increasing",
            "displayFolder": "Test Performance",
            "expression": "COALESCE(COUNTROWS(FILTER(VALUES(Tests[TestName]), [Net Reduction] < 0)),0)",
            "formatString": "#,0",
            "lineageTag": "d725e16f-e36c-492c-bfcd-3f66d17e3ad3"
          },
          {
            "name": "Test Direction",
            "displayFolder": "Test Performance",
            "expression": "SWITCH(TRUE(), [Open Clashes] = 0 && [Previous Clashes] = 0, \"No open clashes\", [Net Reduction] > 0, \"Improving\", [Net Reduction] < 0, \"Increasing\", \"Unchanged\")",
            "lineageTag": "0b4a6eb6-2bb4-4819-89c7-e1889f4f796d"
          },
          {
            "name": "Selected Test Caption",
            "displayFolder": "Test Performance",
            "expression": "IF(HASONEVALUE(Tests[TestName]), SELECTEDVALUE(Tests[TestName]), \"ALL SELECTED TESTS\")",
            "lineageTag": "2fadef65-0c8c-4c11-91fa-f831ff505cb3"
          },
          {
            "name": "Current Open Count",
            "displayFolder": "Coordination workflow",
            "expression": "COALESCE(CALCULATE(COUNTROWS(CurrentClashes),KEEPFILTERS(CurrentClashes[CoordinationState]=\"Actionable\")),0)",
            "formatString": "#,0",
            "lineageTag": "bac546e6-be3a-4d6c-88df-9a932988e942"
          },
          {
            "name": "Current Critical",
            "displayFolder": "Coordination workflow",
            "expression": "COALESCE(CALCULATE([Current Open Count],KEEPFILTERS(CurrentClashes[Severity]=\"Critical\")),0)",
            "formatString": "#,0",
            "lineageTag": "d2b6e579-1552-4c4a-8cec-e1ec471dd5b1"
          },
          {
            "name": "Open 14 Plus",
            "displayFolder": "Coordination workflow",
            "expression": "COALESCE(CALCULATE([Current Open Count],KEEPFILTERS(CurrentClashes[AgeDays]>=14)),0)",
            "formatString": "#,0",
            "lineageTag": "8e10c9f2-f95b-4112-b093-be61c87a9d17"
          },
          {
            "name": "Critical 14 Plus",
            "displayFolder": "Coordination workflow",
            "expression": "COALESCE(CALCULATE([Current Critical],KEEPFILTERS(CurrentClashes[AgeDays]>=14)),0)",
            "formatString": "#,0",
            "lineageTag": "65a6002b-e976-4291-85bf-3feb5710dd27"
          },
          {
            "name": "Average Age Days",
            "displayFolder": "Coordination workflow",
            "expression": "CALCULATE(AVERAGE(CurrentClashes[AgeDays]),KEEPFILTERS(CurrentClashes[CoordinationState]=\"Actionable\"))",
            "formatString": "0.0",
            "lineageTag": "784d9a34-b424-4f9f-99b5-0dedbccf614b"
          },
          {
            "name": "Oldest Age Days",
            "displayFolder": "Coordination workflow",
            "expression": "CALCULATE(MAX(CurrentClashes[AgeDays]),KEEPFILTERS(CurrentClashes[CoordinationState]=\"Actionable\"))",
            "formatString": "0",
            "lineageTag": "c5c29766-babb-4e5b-a228-3f9ef30e9f85"
          },
          {
            "name": "Current Snapshot Caption",
            "displayFolder": "Coordination workflow",
            "expression": "\"AS OF  \" & FORMAT(CALCULATE(MAX(Snapshots[SnapshotDateTime]), REMOVEFILTERS()), \"dd MMM yyyy  |  HH:mm\")",
            "lineageTag": "e5007b74-2f6a-4df0-b1ad-d79a7a9a9836"
          },
          {
            "name": "Age Context",
            "displayFolder": "Coordination workflow",
            "expression": "\"Actionable only: Approved and Resolved excluded. Age at last snapshot; 14+ days is a review threshold.\"",
            "lineageTag": "3611d29c-f84d-409e-9c96-93444a3ce804"
          },
          {
            "name": "Critical Plot",
            "displayFolder": "Clash Details",
            "expression": "IF([Current Critical] > 0, [Current Critical])",
            "formatString": "#,0",
            "lineageTag": "42d6b03d-e7ba-4339-aadd-203e65ad61e6"
          },
          {
            "name": "Detail Selection",
            "displayFolder": "Clash Details",
            "expression": "IF(HASONEVALUE(CurrentClashes[TestName]) && HASONEVALUE(CurrentClashes[ClashGuid]), SELECTEDVALUE(CurrentClashes[ClashGuid]), \"Select one clash row above to inspect its elements\")",
            "lineageTag": "eedace26-7374-4350-9bfb-0ca914862435"
          },
          {
            "name": "A Element ID",
            "displayFolder": "Clash Details",
            "expression": "IF(HASONEVALUE(CurrentClashes[TestName]) && HASONEVALUE(CurrentClashes[ClashGuid]), COALESCE(SELECTEDVALUE(CurrentClashes[ItemAElementId]), \"Not provided\"), \"Select one clash\")",
            "lineageTag": "5c255afd-af57-4e4a-8c2b-403084756e07"
          },
          {
            "name": "A Name",
            "displayFolder": "Clash Details",
            "expression": "IF(HASONEVALUE(CurrentClashes[TestName]) && HASONEVALUE(CurrentClashes[ClashGuid]), COALESCE(SELECTEDVALUE(CurrentClashes[ItemAName]), \"Not provided\"), \"Select one clash\")",
            "lineageTag": "d865702a-3375-43e0-a6ff-329284c90038"
          },
          {
