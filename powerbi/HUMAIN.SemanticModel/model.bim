                " Compatible = List.Accumulate({\"AlertId\",\"ReviewStatus\",\"ReviewReason\",\"ReviewedBy\",\"ReviewedAt\",\"RequiresAction\"}, Headers, (state, col) => if Table.HasColumns(state,col) then state else Table.AddColumn(state,col,each if col=\"RequiresAction\" then Number.From([HasAlert]) else if col=\"ReviewStatus\" then \"Pending Review\" else \"\")),",
                " Typed = Table.TransformColumnTypes(Compatible,{{\"SnapshotDateTime\",type datetime},{\"SnapshotDate\",type datetime},{\"TestName\",type text},{\"PresentInExport\",Int64.Type},{\"PreviousPresent\",Int64.Type},{\"TestMissing\",Int64.Type},{\"TestAdded\",Int64.Type},{\"PreviousTotal\",Int64.Type},{\"CurrentTotal\",Int64.Type},{\"DropPct\",type number},{\"LargeDrop\",Int64.Type},{\"UnknownStatuses\",Int64.Type},{\"Disappeared\",Int64.Type},{\"HasAlert\",Int64.Type},{\"Reason\",type text},{\"AlertId\",type text},{\"ReviewStatus\",type text},{\"ReviewReason\",type text},{\"ReviewedBy\",type text},{\"ReviewedAt\",type text},{\"RequiresAction\",Int64.Type}},\"en-US\")",
