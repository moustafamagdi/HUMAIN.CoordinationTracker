          {
            "name": "Actionable Previous",
            "displayFolder": "Coordination workflow",
            "expression": "VAR b = [Period Start] VAR e = [Period End] VAR prior = CALCULATE(MAX(Snapshots[SnapshotDateTime]),REMOVEFILTERS(Snapshots),Snapshots[SnapshotDateTime]<b) VAR first = CALCULATE(MIN(Snapshots[SnapshotDateTime]),REMOVEFILTERS(Snapshots),Snapshots[SnapshotDateTime]<e) VAR s = COALESCE(prior,first) RETURN IF(NOT ISBLANK(s),COALESCE(CALCULATE(SUM(OperationalProgress[Actionable]),REMOVEFILTERS(Snapshots),Snapshots[SnapshotDateTime]=s),0))",
            "formatString": "#,0",
            "lineageTag": "a7900e96-f345-4794-b638-73a569c3ef79"
          },
          {
            "name": "Net Actionable Reduction",
            "displayFolder": "Coordination workflow",
            "expression": "VAR b = [Period Start] VAR e = [Period End] RETURN COALESCE(CALCULATE(SUM(OperationalProgress[NetActionableReduction]),REMOVEFILTERS(Snapshots),Snapshots[SnapshotDateTime]>=b,Snapshots[SnapshotDateTime]<e,Snapshots[IsBaseline]=\"No\"),0)",
            "formatString": "#,0;-#,0;0",
