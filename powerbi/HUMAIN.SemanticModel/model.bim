          {
            "name": "B Name",
            "displayFolder": "Clash Details",
            "expression": "IF(HASONEVALUE(CurrentClashes[TestName]) && HASONEVALUE(CurrentClashes[ClashGuid]), COALESCE(SELECTEDVALUE(CurrentClashes[ItemBName]), \"Not provided\"), \"Select one clash\")",
            "lineageTag": "75b64136-9646-4d55-b8fd-6a0e451ec2e4"
