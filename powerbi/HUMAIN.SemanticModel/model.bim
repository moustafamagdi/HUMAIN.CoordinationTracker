            "name": "PeriodDates",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                " Start = Date.From(List.Min(Snapshots[SnapshotDateTime])),",
                " Finish = List.Max({Date.From(List.Max(Snapshots[SnapshotDateTime])), Date.From(DateTime.LocalNow())}),",
                " Dates = List.Dates(Start,Duration.Days(Finish-Start)+1,#duration(1,0,0,0))",
                "in Table.FromColumns({Dates},type table [Date=date])"
              ],
              "type": "m"
            }
          }
        ]
      },
