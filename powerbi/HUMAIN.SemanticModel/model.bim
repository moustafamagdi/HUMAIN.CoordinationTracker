        "partitions": [
          {
            "name": "ClashHistory",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                " Source = Csv.Document(File.Contents(SourceFolder & \"\\ClashHistory.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                " Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                " Nulls = Table.ReplaceValue(Headers,\"\",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),",
                " Typed = Table.TransformColumnTypes(Nulls,{{\"SnapshotDateTime\", type datetime},{\"SnapshotDate\", type date},{\"TestName\", type text},{\"ClashGuid\", type text},{\"TrackerState\", type text},{\"NavisworksStatus\", type text},{\"Distance\", type number},{\"DateFound\", type datetime},{\"GridLocation\", type text},{\"X\", type number},{\"Y\", type number},{\"Z\", type number},{\"ItemAElementId\", type text},{\"ItemAName\", type text},{\"ItemALayer\", type text},{\"ItemAPath\", type text},{\"ItemBElementId\", type text},{\"ItemBName\", type text},{\"ItemBLayer\", type text},{\"ItemBPath\", type text},{\"Description\", type text},{\"Comments\", type text},{\"Severity\", type text},{\"DisciplineA\", type text},{\"DisciplineB\", type text},{\"DisciplinePair\", type text},{\"FirstSeen\", type datetime},{\"AgeDays\", Int64.Type},{\"AgeBucket\", type text},{\"ReopenCount\", Int64.Type}},\"en-US\")",
                "in",
                " Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
